// Rule 4: Correlated AI attack
// Fires only when one caller and IP shows all three signals:
// prompt injection burst + token spike + new country.
// All data below is simulated. Users and IPs are fictional.

let AIUsage = datatable(TimeGenerated:datetime, CallerId:string, SourceIP:string, Country:string, FilterResult:string, TotalTokens:int, StatusCode:int)
[
    datetime(2026-11-10 09:00:00), "key-svc", "198.51.100.20", "IN", "None",            900,   200,
    datetime(2026-11-10 09:20:00), "key-svc", "198.51.100.20", "IN", "None",            950,   200,
    datetime(2026-11-10 09:40:00), "key-svc", "198.51.100.20", "IN", "None",            880,   200,
    datetime(2026-11-10 10:05:00), "user1",   "198.51.100.10", "IN", "None",            850,   200,
    datetime(2026-11-10 10:12:00), "user2",   "198.51.100.11", "IN", "None",            920,   200,
    datetime(2026-11-10 10:31:00), "user3",   "198.51.100.12", "IN", "None",            1010,  200,
    datetime(2026-11-10 11:15:00), "user2",   "198.51.100.11", "IN", "PromptInjection", 400,   200,
    datetime(2026-11-10 14:02:00), "key-svc", "203.0.113.50",  "NL", "PromptInjection", 300,   200,
    datetime(2026-11-10 14:03:00), "key-svc", "203.0.113.50",  "NL", "PromptInjection", 310,   200,
    datetime(2026-11-10 14:04:00), "key-svc", "203.0.113.50",  "NL", "PromptInjection", 290,   200,
    datetime(2026-11-10 14:05:00), "key-svc", "203.0.113.50",  "NL", "PromptInjection", 305,   200,
    datetime(2026-11-10 14:07:00), "key-svc", "203.0.113.50",  "NL", "PromptInjection", 315,   200,
    datetime(2026-11-10 14:08:00), "key-svc", "203.0.113.50",  "NL", "PromptInjection", 300,   200,
    datetime(2026-11-10 14:20:00), "key-svc", "203.0.113.50",  "NL", "None",            18000, 200,
    datetime(2026-11-10 14:21:00), "key-svc", "203.0.113.50",  "NL", "None",            18500, 200,
    datetime(2026-11-10 14:22:00), "key-svc", "203.0.113.50",  "NL", "None",            19000, 200,
    datetime(2026-11-10 14:30:00), "user1",   "198.51.100.10", "IN", "None",            870,   200,
    datetime(2026-11-10 14:40:00), "user3",   "198.51.100.12", "IN", "None",            9000,  200
];
let detectStart = datetime(2026-11-10 13:00:00); // in a real workspace: ago(1h)
let window = 10m;
let injectionThreshold = 3;
let multiplier = 5;
// Signal 1: prompt injection burst
let injection = AIUsage
    | where FilterResult == "PromptInjection"
    | summarize Attempts = count() by SourceIP, CallerId, bin(TimeGenerated, window)
    | where Attempts >= injectionThreshold
    | summarize InjectionAttempts = sum(Attempts) by SourceIP, CallerId;
// Signal 2: token spike against the caller's own baseline
let baseline = AIUsage
    | where TimeGenerated < detectStart
    | summarize BaselineAvg = avg(TotalTokens) by CallerId;
let spike = AIUsage
    | where TimeGenerated >= detectStart
    | summarize AvgNow = avg(TotalTokens) by CallerId, SourceIP
    | join kind=inner baseline on CallerId
    | where AvgNow >= multiplier * BaselineAvg
    | project CallerId, SourceIP, BaselineAvg, AvgNow;
// Signal 3: country the caller has never used before
let knownCountries = AIUsage
    | where TimeGenerated < detectStart
    | summarize KnownCountries = make_set(Country) by CallerId;
let newCountry = AIUsage
    | where TimeGenerated >= detectStart
    | join kind=inner knownCountries on CallerId
    | where not(set_has_element(KnownCountries, Country))
    | summarize NewCountryRequests = count(), Country = take_any(Country) by CallerId, SourceIP;
// Correlate: all three signals from the same caller and IP
injection
| join kind=inner spike on CallerId, SourceIP
| join kind=inner newCountry on CallerId, SourceIP
| project CallerId, SourceIP, Country, InjectionAttempts, BaselineAvg, AvgNow, NewCountryRequests
| extend SignalsMatched = 3, Severity = "High"
